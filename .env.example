# Discord Developer Portal values (never commit your real .env file)
TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id

# Your new Discord server
GUILD_ID=your_server_id
ADMIN_ROLE_ID=your_staff_role_id
TICKET_CATEGORY_ID=your_ticket_category_id
TRANSCRIPT_CHANNEL_ID=your_private_transcript_channel_id
PRICE_CHANNEL_ID=your_price_check_channel_id
VOUCH_CHANNEL_ID=your_vouch_channel_id
VOUCH_ROLE_ID=your_vouched_customer_role_id

# Optional: enables screenshot and Uber group-link interpretation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3000
UBER_SCAN_TIMEOUT_MS=45000
UBER_SCAN_MAX_NETWORK_BODIES=10
UBER_SCAN_MAX_NETWORK_CHARS=240000

